{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "allowJs": true,
    "lib": ["ES2022", "dom"],
    "rootDir": "./src",
    "paths": {
      "gi://*": ["./node_modules/@girs/*/"]
    },
    "outDir": "./dist"
  },
  "include": ["src/**/*"]
}
